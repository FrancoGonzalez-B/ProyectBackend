{
  "name": "backendtienda",
  "version": "1.0.0",
  "description": "Backend de tienda en línea con Express, Sequelize y MySQL",
  "main": "app.js",
  "scripts": {
    "test": "node --test",
    "start": "node app.js",
    "dev": "nodemon app.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all",
    "db:create": "node scripts/createDatabase.js",
    "db:verify": "node scripts/verifyDatabase.js",
    "auth:create-admin": "node scripts/createAdmin.js",
    "setup:local": "node scripts/setupLocal.js",
    "test:integration": "node integration/run.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FrancoGonzalez-B/ProyectBackend.git"
  },
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mysql2": "^3.24.2",
    "sequelize": "^6.37.8",
    "swagger-ui-express": "^5.0.1"
  },
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.4",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5"
  }
}
